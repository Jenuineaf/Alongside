# ── Secrets — nothing below this line may ever be committed ──
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/
.venv/
venv/
env/

# ── Django ──
*.log
db.sqlite3
db.sqlite3-journal
/staticfiles/
/media/
local_settings.py

# ── Celery ──
celerybeat-schedule*
celerybeat.pid

# ── Testing / tooling ──
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ── Node (Tailwind build) ──
node_modules/
/static/css/tailwind.output.css

# ── Editors / OS ──
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Seat scaffolding — local to the build process, deliberately not in the public
# repo. `.claude/agents/` are Claude Code sub-agent definitions and
# `docs/team-prompts.md` is the seat roster they came from; both describe how
# this was built rather than what was built, and CONTRIBUTING.md is the
# public-facing version of the same rules. Kept on disk, out of git, so the two
# cannot drift apart again.
.claude/agents/
docs/team-prompts.md
