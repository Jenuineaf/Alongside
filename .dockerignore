.git
.github
.gitignore

# Secrets — belt and braces. These must never reach an image layer.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Local artefacts
db.sqlite3
media/
staticfiles/
*.log

# Docs and editor noise — no reason to invalidate a build layer over them
docs/
*.md
!README.md
.vscode/
.idea/
.DS_Store
Thumbs.db
