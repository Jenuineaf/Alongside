# Buildmates — environment template
#
# Copy to .env and fill in.  NEVER commit .env.
#   cp .env.example .env
#
# Read by django-environ (see config/settings/base.py).
# docker-compose reads this file too, so the same values drive all five services.

# ─────────────────────────────────────────────────────────────
# Core Django
# ─────────────────────────────────────────────────────────────
# Which settings module to load: config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Production MUST refuse to boot on a short or placeholder key.
SECRET_KEY=dev-only-insecure-key-replace-me-in-production-0000000000

DEBUG=True

# Comma-separated. In production set this to your Render hostname.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Comma-separated, scheme required. Needed for Django CSRF behind Render's proxy.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ─────────────────────────────────────────────────────────────
# Database  (PostgreSQL 16)
# ─────────────────────────────────────────────────────────────
# Local docker-compose value. In production this is the Neon pooled connection
# string — Neon requires sslmode=require.
DATABASE_URL=postgres://buildmates:buildmates@postgres:5432/buildmates

# Used only by the postgres container in docker-compose.
POSTGRES_DB=buildmates
POSTGRES_USER=buildmates
POSTGRES_PASSWORD=buildmates

# ─────────────────────────────────────────────────────────────
# Redis  (Celery broker + result backend + cache)
# ─────────────────────────────────────────────────────────────
# Local docker-compose value. In production this is the Upstash URL, which is
# TLS — note the rediss:// scheme (two s's).
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Run tasks inline instead of dispatching to a worker.
# False locally (we run a real worker in Docker).
# True in production on Render's free tier — see docs/deployment.md §4.
CELERY_TASK_ALWAYS_EAGER=False

# ─────────────────────────────────────────────────────────────
# Scheduled jobs  (GitHub Actions cron → secured endpoint)
# ─────────────────────────────────────────────────────────────
# Shared secret the cron workflow sends as the X-Cron-Key header.
# Generate like SECRET_KEY. Stored as a GitHub Actions repository secret.
CRON_SECRET=dev-only-cron-secret-replace-me

# ─────────────────────────────────────────────────────────────
# Media — Cloudinary
# ─────────────────────────────────────────────────────────────
# Leave blank locally to fall back to local filesystem media.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ─────────────────────────────────────────────────────────────
# Error tracking — Sentry
# ─────────────────────────────────────────────────────────────
# Leave blank locally; Sentry stays disabled when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─────────────────────────────────────────────────────────────
# Email  (django-allauth verification + password reset)
# ─────────────────────────────────────────────────────────────
# Console backend prints emails to the log — correct for local dev.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Buildmates <noreply@buildmates.app>
# Only needed when EMAIL_BACKEND is SMTP:
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ─────────────────────────────────────────────────────────────
# Social auth  (django-allauth — Google)
# ─────────────────────────────────────────────────────────────
# Leave blank until a Google OAuth app exists; the button stays hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Production-only
# ─────────────────────────────────────────────────────────────
# Render sets PORT itself; listed here so the value is documented.
PORT=8000
WEB_CONCURRENCY=2
# Render's free tier has one instance, so boot-time migrations are safe.
RUN_MIGRATIONS_ON_START=True
